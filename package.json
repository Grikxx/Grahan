{
  "name": "grahan",
  "version": "0.1.0",
  "private": true,
  "description": "GRAHAN — Abstract strategy game on affine planes over Galois Fields",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
